# Auth.js
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Google OAuth (Classroom, solo lectura)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: clave dedicada para cifrar la URL privada del CVG.
# Si queda vacía, se deriva de AUTH_SECRET.
CVG_ENCRYPTION_KEY=

# Postgres (Neon) — usado por las Notas y por drizzle-kit
DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full
